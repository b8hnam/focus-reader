{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.9.3",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "author": "B8hnam",
  "homepage_url": "https://by.b8hnam.com/focus-reader/",
  "minimum_chrome_version": "116",

  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "sidePanel"],
  "host_permissions": ["<all_urls>"],

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["palette.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["fonts/Vazirmatn-Regular.woff2", "fonts/Vazirmatn-Bold.woff2"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": { "default_path": "sidepanel.html" },

  "options_ui": { "page": "popup.html", "open_in_tab": true },

  "commands": {
    "show-selection": {
      "suggested_key": { "default": "Ctrl+B" },
      "description": "__MSG_cmdShow__"
    },
    "translate-selection": {
      "suggested_key": { "default": "Alt+T" },
      "description": "__MSG_cmdTranslate__"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
